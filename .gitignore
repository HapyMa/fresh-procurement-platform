# =============================================================================
# Git Ignore
# =============================================================================

# Built output
.gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# Android Studio / IntelliJ
.idea/
*.iws
*.iml
*.ipr
out/
!**/app/src/main/**/out/

# Kotlin
*.class
*.kt.bak

# Generated files
bin/
gen/
local.properties

# Log Files
*.log

# Android build outputs
*.apk
*.ap_
*.aab
*.dex
/app/build/outputs/apk/
/app/build/outputs/bundle/
/app/build/outputs/mapping/

# Signing
*.jks
*.keystore
*.p12
*.mobileprovision

# Lint
lint-results*.html
lint-results*.xml
**/reports/

# Environment files
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Spring Boot
*.pid
*.seed

# Application
application-local.yml
application-local.properties

# Package Files (but NOT gradle-wrapper.jar)
*.jar
!gradle-wrapper.jar
!**/gradle-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
